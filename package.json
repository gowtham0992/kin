{
  "name": "kin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A family care circle built as a standards-compliant MCP add-on.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "infra:synth": "cdk synth --app 'tsx infra/app.ts'",
    "seed:aws": "tsx scripts/seed-dynamo.ts",
    "test": "vitest run --exclude 'dist/**'",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1124.0",
    "@aws-sdk/client-sns": "^3.1124.0",
    "@aws-sdk/lib-dynamodb": "^3.1124.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "25.5.0",
    "@types/supertest": "7.2.1",
    "aws-cdk": "^2.1139.0",
    "aws-cdk-lib": "^2.267.0",
    "constructs": "^10.8.1",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
